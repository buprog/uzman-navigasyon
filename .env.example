# PostgreSQL database URL
# Local development: Use docker-compose or Neon free tier
# Production (Vercel): Use Neon, Vercel Postgres, or Supabase
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL="postgresql://localhost:5432/uzman_navigasyon?schema=public"

# Auth secret for session cookies (REQUIRED)
# Generate a strong random string (32+ chars) for production
# Example: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS_LONG_FOR_PRODUCTION"

# Email verification (OPTIONAL)
# Resend API key for sending verification emails
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Admin panel (REQUIRED for admin access)
# Secret path for admin panel (8-64 chars, lowercase letters, numbers, and hyphens)
# The production value is already set in Vercel env vars (never hardcode)
ADMIN_PATH=""

# Google OAuth for admin authentication (REQUIRED)
# Get these from Google Cloud Console: https://console.cloud.google.com
# Redirect URI to register: https://uzman-navigasyon.vercel.app/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin email allowlist (REQUIRED)
# Comma-separated list of allowed Google account emails
# Example: admin@example.com,owner@company.com
ADMIN_ALLOWED_EMAILS=""

# Admin Google sub allowlist (OPTIONAL)
# Comma-separated list of allowed Google sub (user IDs) for extra security
# Example: 123456789012345678901,987654321098765432109
ADMIN_ALLOWED_GOOGLE_SUBS=""

# Admin session secret (OPTIONAL - uses AUTH_SECRET if not set)
ADMIN_SESSION_SECRET=""

# IP allowlist (OPTIONAL)
# Comma-separated list of allowed IPs or CIDR blocks
# If unset, all IPs are allowed (use for dynamic home IPs)
# Example: 203.0.113.1,198.51.100.0/24
ADMIN_IP_ALLOWLIST=""

# Ad settings (OPTIONAL)
# Set to "false" to hide ads for premium users (default: true)
SHOW_ADS_FOR_PREMIUM="true"

# Vercel Blob storage (OPTIONAL)
# For uploading ad images in admin panel
# Get token from Vercel dashboard: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Open-Meteo API (OPTIONAL)
# API key for commercial use of Open-Meteo weather API
# The free tier at api.open-meteo.com is non-commercial only
# Commercial endpoint: customer-api.open-meteo.com with &apikey= parameter
# Get API key from: https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=""
